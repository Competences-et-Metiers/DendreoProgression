FROM node:18-alpine

# Set build argument for branch tracking
ARG BRANCH=prod
ENV GIT_BRANCH=${BRANCH}

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git curl

# Copy package files
COPY package*.json ./

# Install all dependencies for building
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Set build environment
ENV NODE_ENV=production
ENV GENERATE_SOURCEMAP=false
ENV SKIP_PREFLIGHT_CHECK=true
# Force API URL to be relative (this will be passed from docker-compose)
ARG REACT_APP_API_URL=/api
ENV REACT_APP_API_URL=${REACT_APP_API_URL}

# Microsoft Entra ID (Azure AD) - Optional
ARG REACT_APP_AZURE_AD_CLIENT_ID=
ARG REACT_APP_AZURE_AD_TENANT_ID=
ARG REACT_APP_AZURE_AD_REDIRECT_URI=
ENV REACT_APP_AZURE_AD_CLIENT_ID=${REACT_APP_AZURE_AD_CLIENT_ID}
ENV REACT_APP_AZURE_AD_TENANT_ID=${REACT_APP_AZURE_AD_TENANT_ID}
ENV REACT_APP_AZURE_AD_REDIRECT_URI=${REACT_APP_AZURE_AD_REDIRECT_URI}

# Add cache-busting build arguments
ARG BUILD_DATE
ARG BUILD_VERSION
RUN echo "Build date: ${BUILD_DATE:-$(date)}" && \
    echo "Build version: ${BUILD_VERSION:-$(git rev-parse HEAD 2>/dev/null || echo 'no-git')}"

# Show what API URL we're building with
RUN echo "Building React app with API URL: ${REACT_APP_API_URL}"

# Build the React app for production
RUN npm run build

# Copy built files to nginx html directory for volume mounting
RUN mkdir -p /usr/share/nginx/html && cp -r build/* /usr/share/nginx/html/

# Create the build volume directory  
RUN mkdir -p /app/build

# Show build info
RUN echo "Frontend build completed successfully" && \
    echo "API URL: $REACT_APP_API_URL" && \
    ls -la /usr/share/nginx/html/

# Default command - this will be overridden by docker-compose
CMD ["sh", "-c", "echo 'Frontend build completed - files ready for nginx' && sleep infinity"] 