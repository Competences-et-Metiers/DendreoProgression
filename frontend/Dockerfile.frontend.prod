# Stage 1 - Build the React app
FROM node:18-alpine AS builder

ARG BRANCH=prod
ENV GIT_BRANCH=${BRANCH}

WORKDIR /app

RUN apk add --no-cache git curl

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .

ENV NODE_ENV=production
ENV GENERATE_SOURCEMAP=false
ENV SKIP_PREFLIGHT_CHECK=true
# Cap Node.js heap to avoid OOM on memory-constrained hosts
ENV NODE_OPTIONS="--max-old-space-size=1536"

ARG REACT_APP_API_URL=/api
ENV REACT_APP_API_URL=${REACT_APP_API_URL}

# Microsoft Entra ID (Azure AD) - Optional
ARG REACT_APP_AZURE_AD_CLIENT_ID=
ARG REACT_APP_AZURE_AD_TENANT_ID=
ARG REACT_APP_AZURE_AD_REDIRECT_URI=
ENV REACT_APP_AZURE_AD_CLIENT_ID=${REACT_APP_AZURE_AD_CLIENT_ID}
ENV REACT_APP_AZURE_AD_TENANT_ID=${REACT_APP_AZURE_AD_TENANT_ID}
ENV REACT_APP_AZURE_AD_REDIRECT_URI=${REACT_APP_AZURE_AD_REDIRECT_URI}

ARG BUILD_DATE
ARG BUILD_VERSION
RUN echo "Build date: ${BUILD_DATE:-$(date)}" && \
    echo "Build version: ${BUILD_VERSION:-$(git rev-parse HEAD 2>/dev/null || echo 'no-git')}" && \
    echo "Building React app with API URL: ${REACT_APP_API_URL}"

RUN npm run build

# Stage 2 - Serve the build via nginx
FROM nginx:alpine

COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80 443
