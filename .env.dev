# Development Environment Configuration
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=INFO

# Database Configuration (Development)
POSTGRES_DB=dendreo_dev_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
DATABASE_URL=postgresql://postgres:admin@postgres:5432/dendreo_dev_db

# API Configuration (Development)
DENDREO_API_KEY=your_dendreo_api_key_here
DENDREO_BASE_URL=https://pro.dendreo.com/competences_et_metiers/api

# HubSpot Configuration (Development)
HUBSPOT_API_KEY=your_hubspot_api_key_here

# Frontend Configuration (Development)
REACT_APP_API_URL=http://localhost:8000/api
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Redis Configuration (Development)
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=false

# Application Settings
HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1

# Development-specific settings
GENERATE_SOURCEMAP=false
SKIP_PREFLIGHT_CHECK=true
FAST_REFRESH=true
CHOKIDAR_USEPOLLING=true

# Database Settings
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_EXTERNAL_PORT=5433

# Portainer ports
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443