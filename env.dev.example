# Development Environment Configuration
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=DEBUG

# Database Configuration (Development)
POSTGRES_DB=dendreo_dev_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:admin@postgres:5432/dendreo_dev_db

# API Configuration
DENDREO_API_KEY=your_dendreo_api_key_here
DENDREO_BASE_URL=https://pro.dendreo.com/competences_et_metiers/api

# HubSpot Configuration (Optional)
HUBSPOT_API_KEY=your_hubspot_api_key_here

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000/api
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Development Features
PYTHONUNBUFFERED=1
FAST_REFRESH=true
CHOKIDAR_USEPOLLING=true

# GitHub Repository (update with your actual repo)
GITHUB_REPO=https://github.com/YOUR_USERNAME/DendreoProgression.git
DEV_BRANCH=dev