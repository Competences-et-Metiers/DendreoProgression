# Production Environment Configuration
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=INFO

# Database Configuration (Production)
POSTGRES_DB=dendreo_prod_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=
# API Configuration
DENDREO_API_KEY=
DENDREO_BASE_URL=
DENDREO_ADF_LIMIT=              # Optional: limit ADFs for testing (leave empty for production)

# HubSpot Configuration (Optional)
HUBSPOT_API_KEY=pat-eu1-aba2f375-e72b-4c8e-9e84-3b0ca41a93b9

# Frontend Configuration
REACT_APP_API_URL=/api
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Application Settings
HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1

# Frontend Development Features
GENERATE_SOURCEMAP=false
SKIP_PREFLIGHT_CHECK=true
FAST_REFRESH=true
CHOKIDAR_USEPOLLING=true

# Redis Configuration (Optional)
REDIS_URL=redis://redis:6379/0

# Database Settings
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAX_CONNECTIONS=200

# Portainer ports
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443

# Security Configuration
SECRET_KEY=
JWT_SECRET_KEY=

# GitHub Repository (update with your actual repo)
GITHUB_REPO=
PROD_BRANCH=main

# Sync Configuration
SYNC_SCHEDULE="0 * * * *"          # Hourly check - actual schedule is DB-driven
SYNC_LOG_LEVEL=INFO
REDIS_ENABLED=true

# Timezone Configuration
POSTGRES_TZ=Europe/Paris
TZ=Europe/Paris

# Microsoft Entra ID (Azure AD) - Optional SSO
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_ADMIN_GROUP_ID=
AZURE_AD_REDIRECT_URI=https://yourapp.com/login