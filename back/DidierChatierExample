                "numero_perso": "0",
                "numero_comptable": "",
                "langue": "FR",
                "description": "<p><span style=\"font-size: 12pt;\">Selon Maurice Garçon, une grande partie du talent d'un orateur consiste à dissimuler son art et à montrer un naturel qui crée, entre celui qui écoute et lui-même, un courant de sympathie et de confiance.</span></p>\r\n<p><span style=\"font-size: 12pt;\">Quel que soit votre secteur d'activité, prendre la parole en public avec assurance, convaincre et persuader les autres en leur donnant l'impression que votre point de vue est également le leur, s'exprimer de façon claire et concise, gérer ses émotions ainsi que les objections du public sont des compétences indispensables pour réussir à faire passer un message efficacement que ce soit en entreprise ou dans votre vie personnelle. </span></p>\r\n<p><span style=\"font-size: 12pt;\">La formation Prise de parole en public – Devenir un bon orateur vous donnera toutes les clés en main pour y parvenir. Grâce aux applications pratiques et aux mises en situation des notions apprises, vous pourrez vous entraîner activement et dépasser vos limites pour vous impressionner vous-même. Remplissez le formulaire ci-contre pour devenir, vous aussi, expert en éloquence.</span></p>",
                "description_meta": "",
                "hors_formation_dates": "0",
                "hors_formation_prix_par_jour": "0",
                "prix": "2700.0000",
                "prix_intra": "0.0000",
                "prix_edof": "0.0000",
                "prix_inter_category_1": "",
                "prix_intra_category_1": "",
                "prix_achat": "0.0000",
                "duree_heures": "29.000",
                "duree_jours": "9",
                "id_formacode": "439",
                "id_specialite": "59",
                "id_formateur": "7",
                "id_entreprise_formateur": "0",
                "id_categorie_module": "11",
                "nb_participants_min": "0",
                "nb_participants": "0",
                "objectif": "<p><span style=\"color: #2a2a2a; font-size: 12pt;\">Notre formation <strong>Prise de parole en public – Devenir un bon orateur </strong>vous permettra de maîtriser l'art de l'éloquence et de développer les compétences suivantes :</span></p>\r\n<ul>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">maîtriser les techniques d'expression orale pour capter l'attention ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">exploiter la communication non verbale pour développer sa présence et son leadership ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">rythmer et structurer sa présentation pour être synthétique et impactant ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">gérer les objections et les situations difficiles sans se laisser déstabiliser ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">animer des visioconférences efficaces et motivantes.</span></li>\r\n</ul>",
                "public_vise": "<ul>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">commerciaux ou personnel de la relation client en situation de négociation ou soutenance de projet commercial ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">managers en situation d'entretien en face à face avec un collaborateur ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">responsables de services en situation de réunion d'équipe ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">chefs ou contributeurs de projet en situation de présentation projet ou en comité de pilotage ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">dirigeants en situation de discours ou de conférences ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">demandeurs d'emploi en entretien de recrutement.</span></li>\r\n</ul>",
                "pre_requis": "<p><span style=\"font-size: 12pt;\">Pour accéder à la formation P<strong>rise de parole en public – Devenir un bon orateur</strong>, vous devez pratiquer régulièrement des prises de parole en présentiel ou à distance dans un contexte professionnel, et justifier d'au moins une année d'expérience dans l'une des fonctions suivantes :</span></p>\r\n<ul>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">commerciaux ou personnel de la relation client en situation de négociation ou soutenance de projet commercial ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">managers en situation d'entretien en face à face avec un collaborateur ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">responsables de services en situation de réunion d'équipe ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">chefs ou contributeurs de projet en situation de présentation projet ou en comité de pilotage ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">dirigeants en situation de discours ou de conférences ;</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">demandeurs d'emploi en entretien de recrutement. </span></li>\r\n</ul>\r\n<p> </p>\r\n<p><span style=\"font-size: 12pt;\">Par ailleurs, une connexion Internet et un ordinateur seront nécessaires afin de suivre la formation.</span></p>",
                "profil_formateurs": "",
                "id_salle_de_formation": "0",
                "id_orientation_ogdpc": "0",
                "color_adf_par_defaut": "",
                "modalites_devaluation": "<ul>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">QCM à la fin de chaque module.</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Évaluation globale avec des cas pratiques écrits d'une durée d'une heure à l'issue de la formation.</span></li>\r\n</ul>",
                "moyens_supports_pedagogiques": "<ul>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Accès à une plateforme e-learning 24h/24</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Mises en application concrète en classes virtuelles</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Vidéos pédagogiques.</span></li>\r\n</ul>",
                "infos_admission": "",
                "accessibilite": "",
                "modalites_pedagogiques": "<ul>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Feed-backs du formateur pour suivre les progrès et fixer des nouveaux objectifs.</span></li>\r\n<li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Suivi réalisé par un référent pédagogique tout au long de la formation via une adresse mail prévue à cet effet.</span></li>\r\n</ul>",
