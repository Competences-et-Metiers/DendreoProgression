[Unit]
Description=Dendreo Sync Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=cm
Group=cm
WorkingDirectory=/home/cm/DendreoProgression/back
Environment=APP_ENV=production
EnvironmentFile=-/home/cm/DendreoProgression/.env.prod
ExecStartPre=/bin/bash -c 'if [ -f /home/cm/DendreoProgression/venv/bin/activate ]; then source /home/cm/DendreoProgression/venv/bin/activate; fi'
ExecStart=/usr/bin/python3 /home/cm/DendreoProgression/back/scripts/sync_dendreo.py --log-level INFO
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dendreo-sync

# Restart policy
Restart=on-failure
RestartSec=300

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/cm/DendreoProgression/back/logs
ProtectHome=read-only

[Install]
WantedBy=multi-user.target 