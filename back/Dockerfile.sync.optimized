# Multi-stage build to reduce final image size
FROM python:3.11-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install requirements
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Final stage
FROM python:3.11-slim

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    curl \
    cron \
    postgresql-client \
    procps \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory
WORKDIR /app

# Copy application code (only what's needed for sync)
COPY app/ ./app/
COPY scripts/ ./scripts/
COPY *.py ./

# Create logs directory
RUN mkdir -p logs

# Make scripts executable
RUN chmod +x scripts/sync_dendreo.py
RUN chmod +x scripts/check_database_empty.py

# Create sync wrapper script
RUN echo '#!/bin/bash\n\
# Source environment variables\n\
export PYTHONPATH="/app:$PYTHONPATH"\n\
export DATABASE_URL="${DATABASE_URL}"\n\
export DENDREO_API_KEY="${DENDREO_API_KEY}"\n\
export DENDREO_BASE_URL="${DENDREO_BASE_URL}"\n\
export HUBSPOT_API_KEY="${HUBSPOT_API_KEY}"\n\
export REDIS_URL="${REDIS_URL}"\n\
export REDIS_ENABLED="${REDIS_ENABLED}"\n\
export DENDREO_ADF_LIMIT="${DENDREO_ADF_LIMIT}"\n\
export LOG_LEVEL="${LOG_LEVEL:-INFO}"\n\
export APP_ENV="${APP_ENV:-production}"\n\
cd /app\n\
echo "$(date) - Starting sync process"\n\
python3 scripts/sync_dendreo.py --log-level ${LOG_LEVEL:-INFO}\n\
echo "$(date) - Sync process completed"\n\
' > /app/sync_wrapper.sh && chmod +x /app/sync_wrapper.sh

# Create improved entrypoint script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "=== Dendreo Sync Container Starting ==="\n\
echo "Environment: ${APP_ENV:-production}"\n\
echo "Sync Schedule: ${SYNC_SCHEDULE:-0 8 * * *}"\n\
echo "Log Level: ${LOG_LEVEL:-INFO}"\n\
echo "========================================"\n\
\n\
# Wait for database to be available\n\
echo "Waiting for database..."\n\
timeout 60 bash -c "until python -c '\''from app.models.database import engine; from sqlalchemy import text; engine.connect().execute(text(\"SELECT 1\"))'\'' 2>/dev/null; do echo '\''Waiting for database...'\''; sleep 2; done"\n\
echo "Database is ready!"\n\
\n\
# Check if database is empty and run initial sync if needed\n\
echo "🔍 Checking if database is empty..."\n\
if python3 scripts/check_database_empty.py; then\n\
    echo "💾 Database is empty - running initial sync..."\n\
    python3 scripts/sync_dendreo.py --log-level ${LOG_LEVEL:-INFO} --force\n\
    SYNC_RESULT=$?\n\
    if [ $SYNC_RESULT -eq 0 ]; then\n\
        echo "✅ Initial sync completed successfully"\n\
    else\n\
        echo "❌ Initial sync failed with exit code $SYNC_RESULT"\n\
        echo "⚠️  Will continue with cron setup - scheduled syncs may retry"\n\
    fi\n\
else\n\
    echo "📊 Database has data - skipping initial sync"\n\
fi\n\
\n\
# Create environment file for cron\n\
cat > /app/cron_env.sh << EOF\n\
#!/bin/sh\n\
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"\n\
export DATABASE_URL="${DATABASE_URL}"\n\
export DENDREO_API_KEY="${DENDREO_API_KEY}"\n\
export DENDREO_BASE_URL="${DENDREO_BASE_URL}"\n\
export HUBSPOT_API_KEY="${HUBSPOT_API_KEY}"\n\
export REDIS_URL="${REDIS_URL}"\n\
export REDIS_ENABLED="${REDIS_ENABLED}"\n\
export DENDREO_ADF_LIMIT="${DENDREO_ADF_LIMIT}"\n\
export LOG_LEVEL="${LOG_LEVEL:-INFO}"\n\
export APP_ENV="${APP_ENV:-production}"\n\
export PYTHONPATH="/app:$PYTHONPATH"\n\
EOF\n\
chmod +x /app/cron_env.sh\n\
\n\
# Create sync wrapper script for cron\n\
cat > /app/sync_wrapper_cron.sh << EOF\n\
#!/bin/bash\n\
. /app/cron_env.sh\n\
cd /app\n\
echo "\$(date -u '\''+%Y-%m-%d %H:%M:%S UTC'\'') - Starting scheduled sync process (PID: \$\$)"\n\
python3 scripts/sync_dendreo.py --force --log-level \${LOG_LEVEL:-INFO}\n\
echo "\$(date -u '\''+%Y-%m-%d %H:%M:%S UTC'\'') - Scheduled sync process completed (PID: \$\$)"\n\
EOF\n\
chmod +x /app/sync_wrapper_cron.sh\n\
\n\
# Set up cron job\n\
SYNC_SCHEDULE="${SYNC_SCHEDULE:-0 8 * * *}"\n\
echo "Setting up sync cron job: $SYNC_SCHEDULE"\n\
echo "$SYNC_SCHEDULE /app/sync_wrapper_cron.sh >> /app/logs/cron.log 2>&1" | crontab -\n\
\n\
# Verify cron job\n\
echo "📋 Configured cron jobs:"\n\
crontab -l\n\
\n\
# Start cron service\n\
echo "🚀 Starting cron service..."\n\
service cron start\n\
\n\
# Keep the container running\n\
echo "📊 Container ready - monitoring logs..."\n\
tail -f /app/logs/cron.log /var/log/cron.log /var/log/syslog 2>/dev/null || tail -f /dev/null\n\
' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Health check
HEALTHCHECK --interval=1h --timeout=30s --start-period=5m --retries=3 \
  CMD python3 scripts/sync_health_check.py --nagios --exit-code || exit 1

# Run the entrypoint script
CMD ["/app/entrypoint.sh"] 