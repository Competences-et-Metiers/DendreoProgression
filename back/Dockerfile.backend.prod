# Multi-stage build for smaller production image
FROM python:3.11-slim as builder

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Production stage
FROM python:3.11-slim

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get purge -y --auto-remove

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory
WORKDIR /app

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Copy application code
COPY --chown=appuser:appuser . .

# Create logs directory
RUN mkdir -p logs && chown appuser:appuser logs

# Create optimized startup script (runs as appuser via entrypoint)
RUN echo '#!/bin/bash\n\
echo "=== FastAPI Application Starting ==="\n\
echo "Environment: ${APP_ENV:-production}"\n\
echo "Log Level: ${LOG_LEVEL:-INFO}"\n\
echo "======================================"\n\
echo "Waiting for database..."\n\
timeout 60 bash -c "until python -c '\''from app.models.database import engine; from sqlalchemy import text; engine.connect().execute(text(\"SELECT 1\"))'\'' 2>/dev/null; do echo '\''Waiting for database...'\''; sleep 2; done"\n\
echo "Database is ready!"\n\
echo "Creating/updating database tables..."\n\
python -c "from app.models.database import create_tables; create_tables()"\n\
echo "🚀 Starting FastAPI server..."\n\
exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --log-level info --workers ${UVICORN_WORKERS:-2}\n\
' > /app/start.sh && chmod +x /app/start.sh && chown appuser:appuser /app/start.sh

# Create entrypoint that fixes volume permissions then drops to appuser
RUN echo '#!/bin/bash\n\
chown -R appuser:appuser /app/logs 2>/dev/null || true\n\
exec gosu appuser "$@"\n\
' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Install gosu for secure privilege drop
RUN apt-get update && apt-get install -y --no-install-recommends gosu && rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/app/entrypoint.sh"]

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Run the startup script
CMD ["/app/start.sh"] 